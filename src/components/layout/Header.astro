---
import { themeConfig } from '@/config'
import ThemeToggle from '@/components/ui/ThemeToggle.astro'

const pathname = Astro.url.pathname
const isResumePage = pathname === '/resume'
---

<header>
  <nav aria-label="Primary">
    <a class="brand-link" href="/">{themeConfig.site.title}</a>
    <div class="nav-actions">
      <div class="nav-links">
        <a
          class:list={['nav-link', isResumePage && 'is-active']}
          href="/resume"
          aria-current={isResumePage ? 'page' : undefined}
        >
          简历
        </a>
      </div>
      <ThemeToggle />
    </div>
  </nav>
</header>
<style>
  header {
    margin: 0;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .brand-link {
    flex-shrink: 0;
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    text-decoration: none;
    min-width: 3rem;
    display: inline-block;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-width: 0;
    margin-left: auto;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-link {
    position: relative;
    display: inline-block;
    padding: 0.125rem 0;
    font-size: var(--font-size-s);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease-out;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.15rem;
    width: 100%;
    height: 1px;
    background: var(--text-primary);
    opacity: 0.65;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease-out;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--text-primary);
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
  }

  @media (max-width: 480px) {
    .nav-actions {
      gap: 0.75rem;
    }
  }
</style>
